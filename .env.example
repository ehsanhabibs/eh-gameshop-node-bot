# Railway Variables বা Replit Secrets-এ আপনার বিদ্যমান Main Bot Token রাখুন।
BOT_TOKEN=YOUR_MAIN_BOT_TOKEN

# Admin Telegram Numeric ID; একাধিক হলে comma দিয়ে আলাদা করুন।
ADMIN_IDS=123456789

# Railway service-এর Public HTTPS Domain + /portal.html (অথবা Replit Public URL)
WEB_APP_URL=https://YOUR-RAILWAY-DOMAIN/portal.html

# Railway / Replit PORT নিজে সেট করে; সাধারণত এটি পরিবর্তন করবেন না।
PORT=3000

# Customer payment destinations (Send Money accounts)
BKASH_NUMBER=01XXXXXXXXX
NAGAD_NUMBER=01XXXXXXXXX
ROCKET_NUMBER=01XXXXXXXXX

# MongoDB Atlas connection string (required; preserve the existing production database)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=eh_gameshop_fresh

# SMS Activity webhook authentication (set the same value in the SMS Activity HTTP Authorization header)
SMS_WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# Optional: exact bKash SMS sender label/number once confirmed from a real SMS sample
BKASH_SMS_SENDER=bKash
